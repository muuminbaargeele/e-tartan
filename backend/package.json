{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/app.ts",
    "start:dev": "nodemon --watch src --ext ts,js,json --exec ts-node src/app.ts",
    "start:pretty": "ts-node src/app.ts | npx pino-pretty",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typeorm": "ts-node --transpile-only ./node_modules/typeorm/cli.js",
    "migration:run": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "migration:generate": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:generate -d ./src/data-source.ts",
    "migration:create": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:create -d ./src/data-source.ts",
    "migration:gen": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:generate -d ./src/data-source.ts ./src/migrations/$npm_config_name",
    "seed": "ts-node src/seeds/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/sharp": "^0.31.1",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.1",
    "node-cron": "^4.0.7",
    "pino": "^9.6.0",
    "pino-http": "^10.2.0",
    "pino-pretty": "^13.0.0",
    "nodemailer": "^7.0.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3.24",
    "whatsapp-web.js": "^1.34.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.18",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
